# Next.js Configuration
NODE_ENV=development
PORT=3000
HOSTNAME=localhost

# AI Code Analyst now uses Google Gemini API (free tier: 1M tokens/month)
# Get your API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub API Token (optional but recommended to avoid rate limits)
# Create token at: https://github.com/settings/tokens
# Permissions needed: public_repo (read-only)
GITHUB_TOKEN=your_github_personal_access_token_here

# NextAuth.js
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://your-domain.com

# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Admin whitelist
AUTHORIZED_EMAIL=your_authorized_email_here
